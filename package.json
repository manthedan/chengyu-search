{
  "name": "chengyu-search",
  "version": "1.0.0",
  "description": "Hybrid search engine for Chinese idioms (成语)",
  "main": "api-server.js",
  "scripts": {
    "start": "node api-server.js",
    "dev": "nodemon api-server.js",
    "check": "npm run typecheck && npm test && npm run benchmark:relevance -- --fail-on-errors --min-overall 0.45 --min-primary 0.30",
    "smoke:prod": "node scripts/smoke-production.js",
    "test": "node --test test/*.test.js",
    "benchmark": "npm run benchmark:modes && npm run benchmark:latency",
    "benchmark:relevance": "node benchmark/relevance.js",
    "benchmark:modes": "node benchmark/modes.js",
    "benchmark:latency": "node benchmark/latency.js",
    "benchmark:holdout": "node benchmark/holdout.js",
    "benchmark:variant": "node benchmark/evaluate-variant.js",
    "benchmark:embeddings:generate": "node benchmark/generate-embeddings.js",
    "benchmark:embeddings": "node benchmark/bakeoff.js",
    "benchmark:weights": "node benchmark/tune-weights.js",
    "benchmark:failures": "node benchmark/failures.js",
    "benchmark:reranker": "node benchmark/tune-reranker.js",
    "benchmark:routes": "node benchmark/route-audit.js",
    "benchmark:vector-scan": "node benchmark/vector-scan.js",
    "dictionary:build": "node scripts/build-dictionary.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chinese",
    "chengyu",
    "idioms",
    "language-learning",
    "ai",
    "semantic-search",
    "hybrid-search"
  ],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "nodemon": "^3.0.1",
    "typescript": "^6.0.3"
  },
  "private": true,
  "homepage": "https://findchengyu.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manthedan/chengyu-search.git"
  },
  "bugs": {
    "url": "https://github.com/manthedan/chengyu-search/issues"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
